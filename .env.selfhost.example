# Konfiguration für docker-compose.selfhost.yml – als .env neben die Compose-Datei kopieren.
# Anleitung: https://docs.bazarpro.de/selbst-hosten/

# Domain, unter der BazarPro erreichbar ist. convex.<DOMAIN> und
# convex-site.<DOMAIN> müssen ebenfalls auf diesen Server zeigen.
DOMAIN=basar.example.org

# Für Let's-Encrypt-Benachrichtigungen (z. B. ablaufende Zertifikate)
ACME_EMAIL=admin@example.org

# Release von BazarPro, siehe https://github.com/BazarPro/core/releases
BAZARPRO_VERSION=v1.3.0

# E-Mail-Versand (Pflicht: Registrierung und Passwort-Reset laufen per E-Mail-Code)
AUTH_SMTP_HOST=smtp.example.org
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=basar@example.org
AUTH_SMTP_PASS=
AUTH_SMTP_SECURE=false
AUTH_SMTP_STARTTLS=true
# Absender, wie er im Postfach erscheint
AUTH_EMAIL_FROM="Basar <basar@example.org>"

# Optional: Anmeldung mit GitHub oder Google.
# Callback-URL: https://convex-site.<DOMAIN>/api/auth/callback/github (bzw. /google)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: eigene Plausible-Analytics-Instanz
PLAUSIBLE_DOMAIN=
PLAUSIBLE_API_HOST=
