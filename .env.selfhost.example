# Konfiguration für docker-compose.selfhost.yml – als .env neben die Compose-Datei kopieren.
# Anleitung: https://docs.bazarpro.de/selbst-hosten/

# Domain, unter der BazarPro erreichbar ist (DNS-Eintrag auf diesen Server)
DOMAIN=basar.example.org

# Passwort der Datenbank; einmal festlegen, z. B. mit: openssl rand -hex 24
POSTGRES_PASSWORD=

# Für Let's-Encrypt-Benachrichtigungen (z. B. ablaufende Zertifikate)
ACME_EMAIL=admin@example.org

# Release von BazarPro, siehe https://github.com/BazarPro/core/releases
BAZARPRO_VERSION=v2.5.0

# single: ein Verein mit eigenen Basaren (Standard)
# platform: mehrere Veranstalter wie auf bazarpro.de, mit Werbeseiten
BAZARPRO_MODE=single

# Dieses Konto wird Administrator, sobald es sich registriert und die E-Mail bestätigt hat
ADMIN_EMAIL=vorstand@example.org

# E-Mail-Versand (Pflicht: Registrierung und Passwort-Reset laufen per E-Mail-Code)
AUTH_SMTP_HOST=smtp.example.org
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=basar@example.org
AUTH_SMTP_PASS=
AUTH_SMTP_SECURE=false
AUTH_SMTP_STARTTLS=true
# Absender, wie er im Postfach erscheint
AUTH_EMAIL_FROM="Basar <basar@example.org>"

# Optional: Anmeldung mit GitHub oder Google.
# Callback-URL: https://<DOMAIN>/api/auth/oauth/github/callback (bzw. /google/)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: Kartenzahlung mit SumUp über OAuth. Der Veranstalter verbindet sein
# SumUp-Konto einmal, jede Kasse seines Teams kassiert damit. Ohne meldet sich
# jedes Gerät in der App selbst bei SumUp an.
# Redirect-URI der OAuth-App bei SumUp: https://<DOMAIN>/api/sumup/callback
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=

# Optional: Webanalyse mit einer eigenen Plausible-Instanz (oder plausible.io).
# Lässt sich auch ohne Neustart unter Admin > Einstellungen ein- und ausschalten;
# die Datenschutzerklärung nennt Plausible dann automatisch.
PLAUSIBLE_DOMAIN=
PLAUSIBLE_API_HOST=
