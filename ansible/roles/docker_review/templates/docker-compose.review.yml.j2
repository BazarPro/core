# Review app of PR {{ pr_id }}: frontend plus its own backend and database with demo data.
# Removed with all volumes when the pull request is closed.

services:
  postgres:
    image: 'postgres:17-alpine'
    restart: always
    environment:
      - POSTGRES_USER=bazarpro
      - POSTGRES_PASSWORD=review
      - POSTGRES_DB=bazarpro
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ['CMD', 'pg_isready', '-U', 'bazarpro']
      interval: 2s
      timeout: 3s
      retries: 30

  backend:
    image: '{{ ci_registry_image }}/backend:{{ image_tag }}'
    restart: always
    environment: &backend_environment
      - DATABASE_URL=postgres://bazarpro:review@postgres:5432/bazarpro
      - SITE_URL=https://{{ subdomain }}.{{ domain_name }}
      - BAZARPRO_MODE={{ bazarpro_mode }}
      - RUST_LOG=warn
      # All mails go to Mailpit, nothing leaves the server
      - AUTH_SMTP_HOST=mailpit-review-{{ pr_id }}
      - AUTH_SMTP_PORT=1025
      - AUTH_SMTP_SECURE=false
      - AUTH_SMTP_STARTTLS=false
    volumes:
      - files:/data/files
    labels:
      - 'traefik.enable=true'
      - 'traefik.docker.network=proxy'
      - 'traefik.http.routers.backend-review-{{ pr_id }}.rule=Host(`{{ subdomain }}.{{ domain_name }}`) && PathPrefix(`/api`)'
      - 'traefik.http.routers.backend-review-{{ pr_id }}.entrypoints=websecure'
      - 'traefik.http.routers.backend-review-{{ pr_id }}.tls.certresolver=le'
      - 'traefik.http.services.backend-review-{{ pr_id }}.loadbalancer.server.port=3000'
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      default:
        # Unique name: the proxy network is shared with the other review apps
        aliases:
          - backend-review-{{ pr_id }}
      proxy:

  # Demo data with photos; on later deploys it only moves the running demo bazaars to today
  seed:
    image: '{{ ci_registry_image }}/backend:{{ image_tag }}'
    restart: 'no'
    command: ['bazarpro-backend', 'seed']
    environment: *backend_environment
    volumes:
      - files:/data/files
    depends_on:
      backend:
        condition: service_healthy

  # Catches every mail of this review app (OTP codes, notifications, receipts).
  # Inbox at https://{{ subdomain }}-mail.{{ domain_name }} when a password is set.
  mailpit:
    image: 'axllent/mailpit:v1.31.3'
    restart: always
    environment:
      - MP_MAX_MESSAGES=2000
      - MP_SMTP_AUTH_ACCEPT_ANY=true
      - MP_SMTP_AUTH_ALLOW_INSECURE=true
{% if review_mail_password %}
      - MP_UI_AUTH=review:{{ review_mail_password }}
    labels:
      - 'traefik.enable=true'
      - 'traefik.http.routers.mail-review-{{ pr_id }}.rule=Host(`{{ subdomain }}-mail.{{ domain_name }}`)'
      - 'traefik.http.routers.mail-review-{{ pr_id }}.entrypoints=websecure'
      - 'traefik.http.routers.mail-review-{{ pr_id }}.tls.certresolver=le'
      - 'traefik.http.services.mail-review-{{ pr_id }}.loadbalancer.server.port=8025'
{% endif %}
    networks:
      default:
        # Unique name: the proxy network is shared with the other review apps
        aliases:
          - mailpit-review-{{ pr_id }}
      proxy:

  frontend:
    image: '{{ ci_registry_image }}:{{ image_tag }}'
    restart: always
    environment:
      - BACKEND_URL=http://backend-review-{{ pr_id }}:3000
      - SITE_URL=https://{{ subdomain }}.{{ domain_name }}
      - BAZARPRO_MODE={{ bazarpro_mode }}
    labels:
      - 'traefik.enable=true'
      - 'traefik.docker.network=proxy'
      - 'traefik.http.routers.frontend-review-{{ pr_id }}.rule=Host(`{{ subdomain }}.{{ domain_name }}`)'
      - 'traefik.http.routers.frontend-review-{{ pr_id }}.entrypoints=websecure'
      - 'traefik.http.routers.frontend-review-{{ pr_id }}.tls.certresolver=le'
      - 'traefik.http.services.frontend-review-{{ pr_id }}.loadbalancer.server.port=8080'
    depends_on:
      seed:
        condition: service_completed_successfully
    networks:
      - default
      - proxy

networks:
  proxy:
    external: true

volumes:
  postgres_data:
  files:
